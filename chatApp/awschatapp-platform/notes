## Pre-requisites (install once per cluster)

# 1. AWS Load Balancer Controller
#    Requires an IAM role with the AWS managed policy AWSLoadBalancerControllerIAMPolicy
#    bound to the controller's ServiceAccount via IRSA (IAM Roles for Service Accounts).
#
#    a) Create IAM policy (one-time):
curl -o iam-policy.json https://raw.githubusercontent.com/kubernetes-sigs/aws-load-balancer-controller/main/docs/install/iam_policy.json
aws iam create-policy \
  --policy-name AWSLoadBalancerControllerIAMPolicy \
  --policy-document file://iam-policy.json

#    b) Create IRSA service account:
eksctl create iamserviceaccount \
  --cluster=<CLUSTER_NAME> \
  --namespace=kube-system \
  --name=aws-load-balancer-controller \
  --attach-policy-arn=arn:aws:iam::<ACCOUNT_ID>:policy/AWSLoadBalancerControllerIAMPolicy \
  --approve

#    c) Install controller via Helm:
helm repo add eks https://aws.github.io/eks-charts
helm install aws-load-balancer-controller eks/aws-load-balancer-controller \
  -n kube-system \
  --set clusterName=<CLUSTER_NAME> \
  --set serviceAccount.create=false \
  --set serviceAccount.name=aws-load-balancer-controller

# 2. Subnet tags (must be set on VPC subnets in AWS console / CLI — done once)
#
#    Internet-facing ALB discovery:
#      Subnet: chatapp-subnet-public1-us-east-1a
#      Tag:    kubernetes.io/role/elb = 1
#
#    Internal ALB discovery:
#      Subnet: chatapp-subnet-private3-us-east-1a
#      Tag:    kubernetes.io/role/internal-elb = 1
#
#    Both subnets also need: kubernetes.io/cluster/<CLUSTER_NAME> = shared

# 3. RDS CA certificate — upload once per namespace before deploying
#    Download global-bundle.pem from:
#    https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
kubectl create secret generic rds-ca-cert \
  --from-file=global-bundle.pem=./global-bundle.pem \
  -n chatapp --dry-run=client -o yaml | kubectl apply -f -


## Secret file

cp values-prod-secrets.yaml.example values-prod-secrets.yaml
# Fill in:
#   api.secretKey        (openssl rand -hex 32)
#   db.password          (RDS master password — "password01")
#   ingress.tls.certificateArn  (ACM cert ARN for HTTPS, if applicable)


## Deploy commands

# Dev
helm upgrade --install chatapp . \
  --values values.yaml \
  --values values-dev.yaml \
  -n chatapp --create-namespace

# Prod
helm upgrade --install chatapp . \
  --values values.yaml \
  --values values-prod.yaml \
  --values values-prod-secrets.yaml \
  -n chatapp-prod --create-namespace


## AWS connection strings

# RDS MySQL
#   Host:    chatapp-db01.cluster-cknio6ek2ah3.us-east-1.rds.amazonaws.com
#   Port:    3306
#   User:    admin
#   DB:      chatdb
#   SSL:     VERIFY_IDENTITY with global-bundle.pem
#
# ElastiCache Redis (cluster mode — config endpoint)
#   Host:    clustercfg.chatapp-rediscache01.oh16mu.use1.cache.amazonaws.com
#   Port:    6379


## ALB Ingress subnet layout

# The Ingress deploys an internet-facing ALB using:
#   alb.ingress.kubernetes.io/scheme: internet-facing
#   alb.ingress.kubernetes.io/subnets: chatapp-subnet-public1-us-east-1a
#   alb.ingress.kubernetes.io/target-type: ip   (routes directly to pod IPs)
#
# For HTTPS, set in values-prod-secrets.yaml:
#   ingress.tls.certificateArn: arn:aws:acm:us-east-1:<ACCOUNT_ID>:certificate/<ID>
# And in values-prod.yaml the listen-ports annotation is already set to HTTPS:443.


## Useful diagnostics

# Check pods and migration logs
kubectl get pods -n chatapp
kubectl logs -n chatapp -l app.kubernetes.io/name=chat-api -c migrate --tail=15

# Check ALB Ingress status (hostname assigned by AWS)
kubectl get ingress -n chatapp
kubectl describe ingress chatapp-ingress -n chatapp

# Test Redis connectivity from a pod
kubectl run redis-test --image=redis:7-alpine --restart=Never --rm -i \
  -n chatapp \
  --command -- redis-cli \
  -h clustercfg.chatapp-rediscache01.oh16mu.use1.cache.amazonaws.com \
  -p 6379 PING
# redischatapp-db.oh16mu.0001.use1.cache.amazonaws.com 11211  memcache redis aws
# Test MySQL connectivity from a pod
kubectl run mysql-test --image=mysql:8.0 --restart=Never --rm -i \
  -n chatapp \
  --env="MYSQL_PWD=password01" \
  --command -- mysql \
  -h chatapp-db01.cluster-cknio6ek2ah3.us-east-1.rds.amazonaws.com \
  -P 3306 -u admin \
  --ssl-mode=VERIFY_IDENTITY \
  -e "SHOW DATABASES;"

# Restart deployment
kubectl rollout restart deployment/chatapp-api -n chatapp
kubectl rollout status deployment/chatapp-api -n chatapp --timeout=180s

# Access without a hostname (port-forward)
kubectl port-forward svc/chatapp-api 8000:8000 -n chatapp
# Then open http://localhost:8000/docs


