   import subprocess, sys, urllib.request

   subprocess.check_call([sys.executable, "-m", "pip", "install", "pymysql", "cryptography",
   "--quiet"])
   import pymysql

   urllib.request.urlretrieve(
     "https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem",
     "/tmp/global-bundle.pem"
   )

   conn = pymysql.connect(
       host="chatapp-db01.cluster-cknio6ek2ah3.us-east-1.rds.amazonaws.com",
       port=3306, user="admin", passwd="password01",
       ssl_ca="/tmp/global-bundle.pem", ssl_verify_cert=True,
       connect_timeout=10,
   )
   cur = conn.cursor()
   cur.execute("CREATE DATABASE IF NOT EXISTS chatdb CHARACTER SET utf8mb4 COLLATE
   utf8mb4_unicode_ci")
   conn.commit()
   cur.execute("SHOW DATABASES")
   dbs = [r[0] for r in cur.fetchall()]
   conn.close()
   print(f"Done. Databases: {', '.join(dbs)}")
   EOF

