# Copy to values-prod-secrets.yaml and fill in real values.
# values-prod-secrets.yaml is gitignored — never commit it.
#
# Deploy with:
#   helm upgrade --install chatapp . \
#     --values values.yaml \
#     --values values-prod.yaml \
#     --values values-prod-secrets.yaml \
#     -n chatapp-prod --create-namespace

api:
  secretKey: ""       # generate: openssl rand -hex 32

db:
  password: ""        # RDS master password

ingress:
  tls:
    certificateArn: ""  # ACM certificate ARN for ALB HTTPS listener
